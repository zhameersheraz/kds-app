# Copy this file to .env and adjust as needed
PORT=4000

# REQUIRED. The server refuses to boot in production without this.
# Generate a real one (do not reuse the old "kds-dev-secret-change-me" value,
# that key is public in the git history and can no longer be trusted):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-hex-string

# Lock this down to your real frontend origin before exposing the app.
CORS_ORIGIN=*

# Bind on all interfaces so other devices on the LAN can reach the API
HOST=0.0.0.0

# Auto-cancel pending orders idle for longer than this many minutes
STALE_PENDING_MINUTES=30
